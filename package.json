{
  "name": "brm-vite-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "server": "npm run server:build && node server/dist/index.js",
    "server:dev": "npm run server:build && node --watch server/dist/index.js",
    "server:build": "tsc -p server/tsconfig.json",
    "server:clean": "rm -rf server/dist",
    "server:test": "cd server && jest",
    "server:test:watch": "cd server && jest --watch",
    "server:test:coverage": "cd server && jest --coverage",
    "setup-db": "node server/setup-db.js",
    "migrate": "docker compose --profile migration run --rm flyway migrate",
    "migrate:info": "docker compose --profile migration run --rm flyway info",
    "migrate:validate": "docker compose --profile migration run --rm flyway validate",
    "migrate:clean": "docker compose --profile migration run --rm flyway clean",
    "migrate:baseline": "docker compose --profile migration run --rm flyway baseline",
    "migrate:setup": "npm run migrate:baseline && npm run migrate:info",
    "schema:dump": "./scripts/dump-schema.sh"
  },
  "dependencies": {
